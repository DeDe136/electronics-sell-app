# Giá trị cá nhân của môi trường PROD.
#
# Chạy local: cp secrets.tfvars.example secrets.tfvars  rồi điền giá trị thật
#             (secrets.tfvars đã được .gitignore; scripts/tf.sh tự nạp nếu file tồn tại).
# Chạy CI   : không cần file này — truyền qua biến môi trường TF_VAR_alarm_email_addresses
#             và TF_VAR_admin_ssh_cidrs từ GitHub Secrets.

# Email nhận cảnh báo CloudWatch (phải bấm "Confirm subscription" trong thư AWS gửi)
alarm_email_addresses = ["you@example.com"]

# IP public của bạn để SSH vào Harbor/Bastion (https://checkip.amazonaws.com), dạng x.x.x.x/32
admin_ssh_cidrs = ["<your-public-ip>/32"]
